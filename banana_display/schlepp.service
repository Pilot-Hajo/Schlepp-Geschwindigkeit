[Unit]
Description=Schlepp-Geschwindigkeit Display
After=multi-user.target

[Service]
Type=simple
User=root
ExecStartPre=/bin/sh -c "pkill python3 2>/dev/null; sleep 1; true"
ExecStart=/usr/bin/python3 /opt/schlepp/schlepp_display.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

